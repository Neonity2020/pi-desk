{
  "name": "pi-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A desktop workspace for the Pi coding agent",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "package:mac": "tsc --noEmit && electron-vite build && node scripts/package-mac.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "node-pty": "file:vendor/node-pty",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^37.0.0",
    "@electron/asar": "^3.4.1",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
